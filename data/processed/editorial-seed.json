{
  "nodes": [
    {
      "id": "effondrer",
      "pos": "v.t.",
      "gloss": "使坍塌；压垮",
      "note": "前缀 ef-（ex-，向外）+ fond（底部）——「砸穿底部」。及物：effondrer une barrière。"
    },
    {
      "id": "s'effondrer",
      "pos": "v.pr.",
      "gloss": "倒塌；崩溃；垮掉",
      "note": "自反形式最常用。Le marché s'effondre. 市场崩盘。Elle s'est effondrée en larmes. 她泪崩了。"
    },
    {
      "id": "effondré",
      "pos": "adj.",
      "gloss": "崩溃的，被击垮的",
      "note": "过去分词漂移为形容词：肉体坍塌 → 精神被击垮。Il était effondré à la nouvelle."
    },
    {
      "id": "s'écrouler",
      "pos": "v.pr.",
      "gloss": "坍塌；垮掉；累垮",
      "note": "词根 croûte（硬壳）——「外壳剥落而散架」。s'écrouler de fatigue 累瘫；écroulé de rire 笑瘫。"
    },
    {
      "id": "crouler",
      "pos": "v.i.",
      "gloss": "摇摇欲坠；堆积如山",
      "note": "écrouler 的裸词根。crouler sous les dettes 债台高筑。"
    },
    {
      "id": "s'ébouler",
      "pos": "v.pr.",
      "gloss": "（岩壁、土坡）崩塌",
      "note": "词根 boule（土块）——「碎成块状滚落」。专用于山体、陡坡。"
    },
    {
      "id": "éboulement",
      "pos": "n.m.",
      "gloss": "塌方，滑坡",
      "note": "un éboulement de terrain 山体滑坡。"
    },
    {
      "id": "casser",
      "pos": "v.t.",
      "gloss": "打破，弄断",
      "note": "最日常的「弄坏」。casser une branche；se casser la jambe（口语）摔断腿。"
    },
    {
      "id": "briser",
      "pos": "v.t.",
      "gloss": "打碎（文学腔）",
      "note": "比 casser 文雅，常带情感重量：briser un cœur 心碎；briser le silence 打破沉默。"
    },
    {
      "id": "fracasser",
      "pos": "v.t.",
      "gloss": "猛力击碎",
      "note": "casser → briser → fracasser：程度递增，一下子砸个粉碎。"
    },
    {
      "id": "démolir",
      "pos": "v.t.",
      "gloss": "拆除；拆毁；痛击",
      "note": "对建筑物是「拆」；口语里 démolir qn 是痛扁/痛批。"
    },
    {
      "id": "tomber",
      "pos": "v.i.",
      "gloss": "落下，倒下",
      "note": "下降轴的中间态：不受控但未崩解。tomber de fatigue 累倒。"
    },
    {
      "id": "baisser",
      "pos": "v.t./v.i.",
      "gloss": "放低；下降",
      "note": "下降轴的受控端：baisser la tête 低头；les prix baissent 价格下跌；se baisser 弯腰。"
    },
    {
      "id": "fond",
      "pos": "n.m.",
      "gloss": "底部；深处；核心",
      "note": "拉丁语 fundus。au fond de 在…深处；au fond 说到底。坍塌与建立两极共享的词根。"
    },
    {
      "id": "fonder",
      "pos": "v.t.",
      "gloss": "创立，建立",
      "note": "fundare「打下底部」。fonder une famille 成家；fonder une école 创校。"
    },
    {
      "id": "fondation",
      "pos": "n.f.",
      "gloss": "地基；创立；基金会",
      "note": "les fondations d'un immeuble 大楼地基；la Fondation Cartier 卡地亚基金会。"
    },
    {
      "id": "fondateur",
      "pos": "n.m.",
      "gloss": "创始人",
      "note": "le fondateur de l'entreprise 企业创始人。"
    },
    {
      "id": "fondamental",
      "pos": "adj.",
      "gloss": "根本的，基础的",
      "note": "经 fondement（fundamentum）而来。une différence fondamentale 根本差异。"
    },
    {
      "id": "approfondir",
      "pos": "v.t.",
      "gloss": "加深；深入（研究）",
      "note": "profond 同样来自 fundus 家族。approfondir une question 深入钻研一个问题。"
    },
    {
      "id": "établir",
      "pos": "v.t.",
      "gloss": "建立，确立；制定",
      "note": "词源 stabilire「使站稳」——和 effondrer 方向正相反！établir une règle 制定规则；s'établir 定居。"
    },
    {
      "id": "établissement",
      "pos": "n.m.",
      "gloss": "机构；（尤指）学校",
      "note": "由「建立」漂移为「被建立之物」：un établissement scolaire 学校；un établissement public 公立机构。"
    },
    {
      "id": "rétablir",
      "pos": "v.t.",
      "gloss": "恢复，重建",
      "note": "ré- + établir「重新立起来」。rétablir la santé 恢复健康；rétablir la vérité 澄清真相。"
    },
    {
      "id": "édifier",
      "pos": "v.t.",
      "gloss": "建造（宏伟建筑）；教化",
