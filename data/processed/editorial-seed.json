    },
    {
      "id": "édifice",
      "pos": "n.m.",
      "gloss": "大厦，宏伟建筑",
      "note": "正式语境的「大楼」：un édifice religieux；l'édifice social 社会大厦（比喻）。"
    },
    {
      "id": "édifiant",
      "pos": "adj.",
      "gloss": "有教益的；常带讽刺",
      "note": "由「教化」漂移：un spectacle édifiant 表面「有教育意义」，实际常讽刺「令人大跌眼镜」。"
    },
    {
      "id": "ériger",
      "pos": "v.t.",
      "gloss": "竖立；把…树立为",
      "note": "ériger un monument 立碑；ériger qch en principe 把某事奉为原则。"
    },
    {
      "id": "bâtir",
      "pos": "v.t.",
      "gloss": "建造（房屋）",
      "note": "建造轴最具体的一端：bâtir une maison；bâtir un empire（比喻）。"
    },
    {
      "id": "bâtiment",
      "pos": "n.m.",
      "gloss": "建筑物；楼房",
      "note": "通用词：un bâtiment de bureaux 办公楼；le bâtiment（行业）建筑业。"
    },
    {
      "id": "construire",
      "pos": "v.t.",
      "gloss": "建造，构建",
      "note": "最通用：construire une maison / une phrase / une théorie，具体抽象皆可。"
    },
    {
      "id": "fondre",
      "pos": "v.i./v.t.",
      "gloss": "融化；熔解",
