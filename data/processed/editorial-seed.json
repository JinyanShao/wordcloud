      "id": "traîner",
      "pos": "v.i./v.t.",
      "gloss": "拖着脚走；磨蹭（口语）",
      "note": "本义「拖」。traîner dans les rues 街头鬼混（贬）；Ça traîne ! 拖拖拉拉！"
    },
    {
      "id": "cheminer",
      "pos": "v.i.",
      "gloss": "缓步前行（文学）",
      "note": "chemin「路」→ 沿路而行，文学腔。cheminer vers la vérité 向真理缓步前行（比喻）。"
    },
    {
      "id": "marche",
      "pos": "n.f.",
      "gloss": "步子；台阶；进程",
      "note": "marcher 的名词：une marche d'escalier 一级台阶；la marche à suivre 操作步骤。"
    },
    {
      "id": "démarche",
      "pos": "n.f.",
      "gloss": "步态；方法，举措",
      "note": "从「走路的方式」漂移为「办事的方式」。une démarche élégante 优雅步态；faire des démarches 奔走办事。"
    },
    {
      "id": "marché",
      "pos": "n.m.",
      "gloss": "市场",
      "note": "拉丁语 mercatus（交易）——和 marcher 毫无词源关系！le marché aux puces 跳蚤市场；bon marché 便宜。"
    },
    {
      "id": "marchand",
      "pos": "n.m./adj.",
      "gloss": "商人；商业的",
      "note": "marché 家族：un marchand de fruits 水果商；la marine marchande 商船队。"
    },
    {
      "id": "pas",
      "pos": "n.m.",
      "gloss": "脚步，步伐",
      "note": "拉丁语 passus「一步」。faire un pas 迈一步；pas à pas 一步步地。否定词 pas 也来自它——「一步也不」的强调。"
    },
    {
      "id": "partir",
      "pos": "v.i.",
      "gloss": "离开，出发",
      "note": "拉丁语 partire「分」——出发就是「与大部队分开」。partir de Paris；partir en vacances 去度假。"
    },
    {
      "id": "s'en aller",
      "pos": "v.pr.",
      "gloss": "走开，离去",
      "note": "口语最常用的离开。Je m'en vais. 我走了。Va-t'en ! 走开！"
    },
    {
      "id": "quitter",
      "pos": "v.t.",
      "gloss": "离开（某人/某地）",
      "note": "及物：必须带离开的对象。quitter Paris 离开巴黎；quitter son mari 与丈夫分手。quitus「解脱」。"
    },
    {
      "id": "sortir",
      "pos": "v.i./v.t.",
      "gloss": "出去；出门玩",
      "note": "从内到外的离开。sortir de la pièce 走出房间；sortir avec des amis 和朋友出去玩；sortir avec qn 约会。"
    },
    {
      "id": "filer",
      "pos": "v.i.",
      "gloss": "溜走，飞奔而去（口语）",
      "note": "fil「线」——像线一样顺滑地溜掉。Il faut que je file. 我得溜了。口语 filer qch à qn 是「塞给」。"
    },
    {
      "id": "décamper",
      "pos": "v.i.",
      "gloss": "溜之大吉（口语）",
      "note": "dé- + camp「拆营跑路」。Il a décampé sans payer. 他没付钱就溜了。"
    },
    {
      "id": "déguerpir",
      "pos": "v.i.",
      "gloss": "仓皇逃走（口语/诙谐）",
      "note": "带狼狈、诙谐色彩的开溜。déguerpir de la fête 从聚会上溜之大吉。"
    },
    {
      "id": "échapper",
      "pos": "v.i./v.pr.",
      "gloss": "逃脱；溜走",
      "note": "ex- + cappa（斗篷）——挣脱斗篷溜走。s'échapper de prison 越狱；laisser échapper un mot 说漏嘴。"
    },
    {
      "id": "départ",
      "pos": "n.m.",
      "gloss": "出发；起点",
      "note": "partir 的名词。l'heure du départ 出发时间；au départ 起初（时间起点的比喻）。"
    },
    {
      "id": "repartir",
      "pos": "v.i.",
      "gloss": "再出发；重新振作",
      "note": "re- + partir。repartir à zéro 从头再来；repartir en courage 重拾勇气。"
    },
    {
      "id": "partager",
      "pos": "v.t.",
      "gloss": "分享；分担",
      "note": "和 partir 同根（partire「分」）：partir 是「各自分头」，partager 是「分东西」。partager un repas 分食一餐。"
    }
  ],
