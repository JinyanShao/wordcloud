{
  "name": "wordcloud-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "data:build": "node scripts/extract_seed.mjs && python3 scripts/build_data.py build",
    "data:fetch": "python3 scripts/fetch_sources.py --download",
    "data:verify-sources": "python3 scripts/fetch_sources.py",
    "test:fetch-sources": "python3 scripts/test_fetch_sources.py",
    "data:review": "python3 scripts/apply_audit_review.py && python3 scripts/build_data.py sync-review",
    "demonette:analyze": "node scripts/extract_seed.mjs && python3 scripts/import_demonette.py analyze",
    "demonette:approve": "python3 scripts/import_demonette.py approve",
    "dbnary:analyze": "python3 scripts/import_dbnary.py analyze",
    "dbnary:approve": "python3 scripts/import_dbnary.py approve",
    "wiktextract:audit": "python3 scripts/audit_wiktextract.py run && python3 scripts/audit_wiktextract.py report",
    "wiktextract:audit:report": "python3 scripts/audit_wiktextract.py report",
    "wiktextract:p0:analyze": "python3 scripts/import_wiktextract_p0.py analyze",
    "wiktextract:p0:approve": "python3 scripts/import_wiktextract_p0.py approve",
    "dbnary:alignment-queue": "python3 scripts/build_dbnary_alignment_queue.py",
    "graph:candidates": "node scripts/extract_seed.mjs && python3 scripts/build_graph.py",
    "graph:layout": "node scripts/layout.mjs",
    "graph:export": "python3 scripts/export_runtime.py && python3 scripts/update_runtime_cache.py",
    "graph:build": "pnpm demonette:analyze && pnpm demonette:approve && pnpm dbnary:analyze && pnpm dbnary:approve && pnpm wiktextract:p0:approve && pnpm graph:candidates && pnpm graph:layout && pnpm graph:export",
    "test:drafts": "node tests/draft-tools.test.mjs",
    "test:search": "node tests/search-tools.test.mjs",
    "test:word-card": "node tests/word-card-tools.test.mjs",
    "test:review": "node tests/review-tools.test.mjs",
    "test:local-data": "node tests/local-data-tools.test.mjs",
    "smoke:browser": "node scripts/browser_acceptance_smoke.mjs",
    "release:package": "node scripts/package_static_release.mjs",
    "check": "pnpm test:fetch-sources && python3 scripts/validate_data.py && pnpm test:drafts && pnpm test:search && pnpm test:word-card && pnpm test:review && pnpm test:local-data",
    "build:verified": "python3 scripts/build_verified.py",
    "build:verify-manifest": "python3 scripts/write_build_manifest.py verify"
  },
  "devDependencies": {
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1"
  }
}
